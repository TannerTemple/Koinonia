# Copy to apps/api/.env (API) — web and mobile read their own vars, listed at the bottom.

# --- API -------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/koinonia"
# Used only by `pnpm test`
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/koinonia_test"
PORT=4000
# Comma-separated origins allowed to call the API from a browser
CORS_ORIGINS="http://localhost:3000"
# Public URL of the web app (used in emails / invite links)
WEB_URL="http://localhost:3000"
# Run the daily reminder digest inside the API process (true/false)
DIGEST_ENABLED=false
# Hour of day (0-23, in each user's timezone) to send the digest
DIGEST_HOUR=8

# --- Outside services: all mocked until a key is present -------------------
# Email (reminder digests). Provider: Resend — https://resend.com
RESEND_API_KEY=
EMAIL_FROM="Koinonia <hello@example.com>"
# SMS (text reminders). Provider: Twilio — https://twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Push notifications go through Expo's push service; an access token is optional
EXPO_ACCESS_TOKEN=

# --- Web (apps/web/.env.local) ---------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:4000"

# --- Mobile (apps/mobile/.env) ---------------------------------------------
# Use your computer's LAN IP when running on a physical phone
EXPO_PUBLIC_API_URL="http://localhost:4000"
