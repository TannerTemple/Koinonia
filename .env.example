# Copy to apps/api/.env (API) — web and mobile read their own vars, listed at the bottom.

# --- API -------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/koinonia"
# Direct (unpooled) connection for migrations. Leave unset locally: it defaults to DATABASE_URL.
# On Neon: DATABASE_URL = pooled string (-pooler in the host), DIRECT_URL = direct string.
# DIRECT_URL=
# Used only by `pnpm test`
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/koinonia_test"
# Optional: Domain for the web session cookie when web and API are on different subdomains, e.g. .example.com
# COOKIE_DOMAIN=
# Proxies in front of the API: false locally, 1 on most hosts (see docs/DEPLOY.md)
TRUST_PROXY=false
# Lets an outside scheduler run the digest: POST /v1/jobs/digest with header X-Cron-Secret (24+ characters)
# CRON_SECRET=
# debug | info | warn | error
LOG_LEVEL=info
PORT=4000
# Comma-separated origins allowed to call the API from a browser (web app, Expo web preview)
CORS_ORIGINS="http://localhost:3000,http://localhost:8081"
# Public URL of the web app (used in emails / invite links)
WEB_URL="http://localhost:3000"
# Run the daily reminder digest inside the API process (true/false)
DIGEST_ENABLED=false
# Hour of day (0-23, in each user's timezone) to send the digest
DIGEST_HOUR=8

# --- Outside services: all mocked by default --------------------------------
# Email (password reset, email confirmation, reminder digests).
# mock = record and log, send nothing. resend = send through https://resend.com
EMAIL_PROVIDER=mock
# Needed only with EMAIL_PROVIDER=resend. The sender must be on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="Koinonia <hello@example.com>"
# EMAIL_REPLY_TO=
# SMS (text reminders). Provider: Twilio — https://twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Push notifications go through Expo's push service; an access token is optional
EXPO_ACCESS_TOKEN=

# --- Web (apps/web/.env.local) ---------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:4000"
# Hosted: set NEXT_PUBLIC_API_URL=/api and API_PROXY_TARGET to the API's address (docs/DEPLOY.md)
# API_PROXY_TARGET=
# Shown on the privacy policy and terms pages
# NEXT_PUBLIC_CONTACT_EMAIL=
# NEXT_PUBLIC_OPERATOR_NAME=

# --- Mobile (apps/mobile/.env) ---------------------------------------------
# Use your computer's LAN IP when running on a physical phone
EXPO_PUBLIC_API_URL="http://localhost:4000"
# Where the web app lives (the app links to its privacy policy and terms)
EXPO_PUBLIC_WEB_URL="http://localhost:3000"
