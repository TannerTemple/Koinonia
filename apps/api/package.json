{
  "name": "@koinonia/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/prisma.mjs generate",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "build": "node scripts/prisma.mjs generate && tsup src/server.ts",
    "typecheck": "node scripts/prisma.mjs generate && tsc --noEmit",
    "test": "vitest run",
    "db:generate": "node scripts/prisma.mjs generate",
    "db:migrate": "node scripts/prisma.mjs migrate deploy && node scripts/prisma.mjs generate",
    "db:migrate:dev": "node scripts/prisma.mjs migrate dev",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "db:reset": "node scripts/prisma.mjs migrate reset --force && pnpm db:seed",
    "digest": "tsx --env-file-if-exists=.env src/jobs/run-digest.ts",
    "email:test": "tsx --env-file-if-exists=.env src/jobs/send-test-email.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.2.0",
    "@koinonia/shared": "workspace:*",
    "@prisma/client": "6.19.3",
    "fastify": "^5.6.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prisma": "6.19.3",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "vitest": "^3.2.0"
  }
}
